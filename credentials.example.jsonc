{
  // JSONC: Chỉ giữ các nhóm/account cần dùng. Có thể dùng comment // hoặc #.
  // Nên dùng hậu tố _env để lấy secret từ biến môi trường, tránh ghi password trực tiếp.
  "ssh": [
    {
      // Trường hợp 1: SSH bằng username/password, có nâng quyền bằng sudo.
      // Giá trị: password | public key | certificate | Kerberos.
      "auth_method": "password",
      // User trên Linux/Unix hoặc network device. Ví dụ: scan-audit, root, admin.
      "username": "scan-audit",
      // Tên biến môi trường chứa mật khẩu SSH. Có thể dùng "password": "..." nhưng không khuyến nghị.
      "password_env": "NCTL_TARGET_SSH_PASSWORD",
      // Giá trị: Nothing | sudo | su | su+sudo | dzdo | pbrun | .k5login | Cisco 'enable'.
      "elevate_privileges_with": "sudo",
      // User đích khi nâng quyền; thường là root. Có thể bỏ khi dùng sudo mặc định.
      "escalation_account": "root",
      // Tên biến môi trường chứa sudo/su password; có thể trùng mật khẩu SSH.
      "escalation_password_env": "NCTL_TARGET_SUDO_PASSWORD",
      // Thư mục chứa sudo/su, thường là /usr/bin. Có thể bỏ để máy chủ quét tự tìm.
      "bin_directory": "/usr/bin",
      // IP, hostname hoặc CIDR ưu tiên credential này; bỏ field để áp dụng cho mọi target.
      "target_priority_list": "192.0.2.0/24"
    },
    {
      // Trường hợp 2: SSH bằng private key.
      "auth_method": "public key",
      // User tương ứng với public key đã cài trong authorized_keys.
      "username": "scan-audit",
      // Đường dẫn tương đối tính từ file config. Chương trình tự upload key lên máy chủ quét.
      "private_key_file": "keys/id_rsa",
      // Xóa field này nếu private key không có passphrase.
      "private_key_passphrase_env": "NCTL_TARGET_SSH_KEY_PASSPHRASE",
      // Không nâng quyền. Có thể đổi thành sudo/su và thêm escalation password.
      "elevate_privileges_with": "Nothing"
    }
  ],
  "windows": [
    {
      // Giá trị: Password | NTLM Hash | LM Hash | Kerberos | Windows LAPS.
      "auth_method": "Password",
      // Domain NetBIOS, ví dụ EXAMPLE. Dùng chuỗi rỗng "" cho local account.
      "domain": "EXAMPLE",
      // Ví dụ: scan-audit hoặc Administrator; không cần ghép EXAMPLE\ vào username.
      "username": "scan-audit",
      // Với NTLM Hash/LM Hash, biến môi trường này chứa hash thay vì password.
      "password_env": "NCTL_TARGET_WINDOWS_PASSWORD"
    }
  ],
  "snmpv3": [
    {
      // SNMPv3 security name/user đã cấu hình trên router, switch hoặc server.
      "username": "scan-snmp",
      // Cổng SNMP UDP; mặc định 161, phạm vi hợp lệ 1-65535.
      "port": 161,
      // Thông thường dùng Password Entry; máy chủ quét còn hỗ trợ credential manager như CyberArk.
      "snmp_auth_method": "Password Entry",
      // Giá trị: No authentication and no privacy | Authentication without privacy | Authentication and privacy.
      "security_level": "Authentication and privacy",
      // Giá trị: SHA1 | SHA-224 | SHA-256 | SHA-384 | SHA-512 | MD5.
      "auth_algorithm": "SHA-256",
      // Không cần field này nếu security_level là No authentication and no privacy.
      "auth_password_env": "NCTL_TARGET_SNMP_AUTH_PASSWORD",
      // Giá trị: AES | AES192 | AES192C | AES256 | AES256C | DES.
      "privacy_algorithm": "AES",
      // Chỉ cần khi security_level là Authentication and privacy.
      "privacy_password_env": "NCTL_TARGET_SNMP_PRIVACY_PASSWORD",
      // IP/CIDR ưu tiên credential này; bỏ field nếu dùng chung cho tất cả target.
      "target_priority_list": "192.0.2.0/24"
    }
  ],
  "settings": {
    // Cổng SSH toàn cục, mặc định 22.
    "ssh_port": "22",
    // yes an toàn hơn; checkbox của máy chủ quét nhận yes hoặc no.
    "never_send_win_creds_in_the_clear": "yes",
    // yes buộc không dùng NTLMv1; nên giữ yes.
    "dont_use_ntlmv1": "yes"
  }
}
